{
  "name": "lhbib-lunch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n srv,web \"cross-env PORT=3001 node server/index.js\" \"vite --port 5173 --strictPort\"",
    "build": "vite build",
    "start": "node server/index.js",
    "db:push": "prisma db push",
    "test": "cross-env DATABASE_URL=postgresql://postgres:test@localhost:5435/postgres prisma db push --skip-generate && cross-env DATABASE_URL=postgresql://postgres:test@localhost:5435/postgres vitest run",
    "test:db:up": "docker run --rm -d --name lhbib-test-db -e POSTGRES_PASSWORD=test -p 5435:5432 postgres:17-alpine",
    "test:db:down": "docker stop lhbib-test-db"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
